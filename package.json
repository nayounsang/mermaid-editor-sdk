{
  "name": "mermaid-editor-sdk-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@mermaid-editor/example",
    "storybook": "turbo run storybook --filter=@mermaid-editor/storybook",
    "build-storybook": "turbo run build-storybook --filter=@mermaid-editor/storybook",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm changeset publish",
    "audit:distribution": "turbo run audit:distribution --filter=@mermaid-editor-sdk/ui",
    "csp:fixture": "pnpm --filter @mermaid-editor-sdk/ui csp:fixture",
    "update-codex-plugin": "node scripts/update-codex-plugin.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "2.11.4"
  }
}
