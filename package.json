{
  "name": "mermaid-editor-sdk-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@mermaid-editor/web",
    "storybook": "turbo run storybook --filter=@mermaid-editor/storybook",
    "build-storybook": "turbo run build-storybook --filter=@mermaid-editor/storybook",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "docs:api": "typedoc --options typedoc.headless.json && typedoc --options typedoc.ui.json && node scripts/normalize-api-parameter-defaults.mjs app/web/app/generated/api/headless app/web/app/generated/api/ui && node scripts/generate-api-sitemap.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm changeset publish",
    "audit:distribution": "turbo run audit:distribution --filter=@mermaid-editor-sdk/ui",
    "csp:fixture": "pnpm --filter @mermaid-editor-sdk/ui csp:fixture",
    "update-codex-plugin": "node scripts/update-codex-plugin.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint-plugin-jsdoc": "^65.3.8",
    "turbo": "2.11.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0"
  }
}
