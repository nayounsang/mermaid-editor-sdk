{
  "name": "mermaid-visual-editor-sdk",
  "version": "0.1.0",
  "description": "Framework independent Mermaid visual editor SDK",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-LICENSES"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/mermaid-visual-editor.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.types.json && node scripts/generate-third-party-licenses.mjs",
    "csp:fixture": "node scripts/serve-csp-fixture.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
