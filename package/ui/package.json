{
  "name": "@mermaid-editor-sdk/ui",
  "version": "0.0.2",
  "description": "Composable React UI and full Mermaid visual editor SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nayounsang/mermaid-editor-sdk.git",
    "directory": "package/ui"
  },
  "type": "module",
  "files": ["dist", "src", "LICENSE", "THIRD-PARTY-LICENSES"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/mermaid-visual-editor.iife.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "source": "./src/ui/context/index.ts",
      "types": "./dist/ui/context/index.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./toolbar": {
      "source": "./src/ui/components/ToolSidebar.tsx",
      "types": "./dist/ui/components/ToolSidebar.d.ts",
      "import": "./dist/toolbar.js",
      "require": "./dist/toolbar.cjs"
    },
    "./source": {
      "source": "./src/ui/components/SourceEditor.tsx",
      "types": "./dist/ui/components/SourceEditor.d.ts",
      "import": "./dist/source.js",
      "require": "./dist/source.cjs"
    },
    "./renderer": {
      "source": "./src/ui/components/MermaidCanvas.tsx",
      "types": "./dist/ui/components/MermaidCanvas.d.ts",
      "import": "./dist/renderer.js",
      "require": "./dist/renderer.cjs"
    },
    "./components": {
      "source": "./src/ui/components/index.ts",
      "types": "./dist/ui/components/index.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    },
    "./style.css": {
      "source": "./src/styles/editor.css",
      "default": "./dist/style.css"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.legacy.config.ts && tsc -p tsconfig.types.json && node scripts/generate-third-party-licenses.mjs",
    "prepack": "pnpm run build",
    "csp:fixture": "node scripts/serve-csp-fixture.mjs",
    "audit:distribution": "node scripts/audit-distribution-licenses.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/react": "^0.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@mermaid-editor-sdk/headless": "workspace:*",
    "@uiw/react-codemirror": "^4.25.12",
    "es-toolkit": "^1.52.0",
    "mermaid": "11.17.2",
    "p-queue": "^9.3.3",
    "react-hook-form": "^7.89.0",
    "react-resize-detector": "^12.3.0",
    "zustand": "^5.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
