{
  "entryPoints": ["package/ui/src/index.ts"],
  "tsconfig": "package/ui/tsconfig.json",
  "entryPointStrategy": "resolve",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api/ui",
  "name": "@mermaid-editor-sdk/ui",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "parametersFormat": "table",
  "validation": {
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Class",
    "Function",
    "Interface",
    "Method",
    "TypeAlias"
  ],
  "sourceLinkTemplate": "https://github.com/nayounsang/mermaid-editor-sdk/blob/main/{path}#L{line}"
}
